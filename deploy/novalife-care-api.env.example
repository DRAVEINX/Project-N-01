# Placeholder values only. Never commit real secrets.
NODE_ENV=production
HOST=0.0.0.0
PORT=8080
DATABASE_URL=postgresql://novalife_api:REPLACE_WITH_SECRET@YOUR_DATABASE_HOST:5432/postgres
DATABASE_POOL_SIZE=5
ALLOWED_ORIGINS=https://YOUR_WEB_APP_ORIGIN,capacitor://localhost,http://localhost

# Choose one transport mode:
# Direct TLS: set both paths to mounted certificate/key files.
TLS_CERT_PATH=
TLS_KEY_PATH=
# Or, for a platform TLS proxy, use true only if direct access to the app port
# is blocked and the proxy overwrites X-Forwarded-Proto.
NOVALIFE_TRUST_PROXY=false

# Change to true only after the host/ingress rate limits login and mutations.
NOVALIFE_EXTERNAL_RATE_LIMIT_CONFIRMED=false
