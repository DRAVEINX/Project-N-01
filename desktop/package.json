{
  "name": "novalife-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Windows desktop package for the NovaLife daily-life companion",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dist:msi": "electron-builder --win msi --x64"
  },
  "devDependencies": {
    "electron": "44.9.0",
    "electron-builder": "26.17.0"
  },
  "build": {
    "appId": "com.draveinx.projectn01.desktop",
    "productName": "NovaLife",
    "asar": true,
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.cjs",
      "web/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "msi",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "NovaLife-0.1.0-x64.msi",
      "icon": "build/icon.svg"
    },
    "msi": {
      "perMachine": false,
      "runAfterFinish": false
    }
  }
}
